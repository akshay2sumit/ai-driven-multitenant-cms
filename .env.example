# Environment Configuration Template for Ai-cms (CI4)
# Copy this to .env and configure for your environment

# CI4 Base Configuration
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.timezone = 'America/New_York'
app.defaultLocale = 'en'
app.negotiateLocale = false
app.supportedLocales = ['en']
app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionCookieName = 'ci_session'
app.sessionExpiration = 7200
app.sessionSavePath = null
app.sessionMatchIP = false
app.sessionTimeToUpdate = 300
app.sessionRegenerateDestroy = false
app.CSRFProtection = true
app.CSRFCookieName = 'csrf_cookie_name'
app.CSRFExpire = 7200
app.CSRFRegenerate = true
app.CSRFExcludeURIs = []
app.CSRFRedirect = true
app.CSRFTokenName = 'csrf_token_name'
app.CSRFSameSite = 'Lax'
app.cookiePrefix = ''
app.cookieDomain = ''
app.cookiePath = '/'
app.cookieSecure = false
app.cookieHTTPOnly = false
app.cookieSameSite = 'Lax'
app.reverseProxyUser = ''
app.reverseProxyHeader = 'HTTP_X_FORWARDED_FOR'
app.reverseProxyAddresses = []

# Database Configuration
database.default.hostname = 'localhost'
database.default.database = 'ai_cms'
database.default.username = 'root'
database.default.password = ''
database.default.DBDriver = 'MySQLi'
database.default.DBPrefix = ''
database.default.port = 3306

# Encryption Key (Generate a new one for production)
app.encryptionKey = 'your-encryption-key-here'

# AI Integration (External API Keys - Secure in production)
ai.apiKey = 'your-ai-api-key'
ai.endpoint = 'https://api.example.com'

# Email Configuration
email.fromEmail = 'noreply@example.com'
email.fromName = 'Ai-cms'
email.SMTPHost = ''
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = 587
email.SMTPCrypto = 'tls'

# Logging
logger.threshold = 4

# Other
# Add custom configs as needed